# mock = 内存假数据，前端独自跑通交互；api = 打 api/ui/ 的真接口
# ★ api 这半边要先在仓库根目录起后端：uv run uvicorn --factory api:create_app --port 8090
#   （端口出处是 config.example.toml 的 [api] port）。`/v1` 靠 vite.config.ts
#   的 server.proxy 转发过去 —— 没有那段转发，打的是 Vite 自己。
VITE_DATA_SOURCE=mock
VITE_API_BASE=/v1
VITE_API_TIMEOUT_MS=8000
